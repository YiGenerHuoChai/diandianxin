---
import Layout from '../layouts/Layout.astro';
import Blocks from './Blocks.astro';
import site from '../content/site.json';
import home from '../content/pages/home.json';

interface Props {
  page: {
    path: string;
    title: string;
    tagline?: string;
    description?: string;
    back?: boolean;
    wide?: boolean;
    blocks: Array<Record<string, any>>;
  };
}

const { page } = Astro.props;

const brandSuffix = page.path === '/' ? '' : ` · ${home.title}`;
const pageTitle = [site.brand, page.title].filter(Boolean).join(' · ') + brandSuffix;
const description = page.description ?? page.tagline ?? '';

const navItems = (page.blocks || [])
  .map((block, i) => ({ index: i, label: block.nav }))
  .filter((item) => item.label);
---

<Layout title={pageTitle} description={description}>
  <div class={page.wide ? 'shell shell-wide' : 'shell'}>
    <header class="intro">
      <p class="brand">{site.brand} <span class="brand-en">{site.brandEn}</span></p>

      <h1 class="name">{page.title}</h1>

      <p class="tagline">{page.tagline}</p>

      <footer class="intro-foot">
        {page.back ? (
          <a href="/">← 回首页</a>
        ) : (
          <a href={`mailto:${site.email}`}>{site.email}</a>
        )}
      </footer>
    </header>

    <nav class="chapters" aria-label="页面导航">
      {navItems.map((item) => (
        <a class="chapter-link" href={`#block-${item.index}`}>{item.label}</a>
      ))}
    </nav>

    <main class="content">
      <Blocks blocks={page.blocks} />
    </main>
  </div>
</Layout>
