---
import Layout from '../layouts/Layout.astro';
import Blocks from './Blocks.astro';
import site from '../content/site.json';
import home from '../content/pages/home.json';

interface Props {
  page: {
    path: string;
    title: string;
    tagline?: string;
    description?: string;
    back?: boolean;
    wide?: boolean;
    scroll?: boolean;
    blocks: Array<Record<string, any>>;
  };
}

const { page } = Astro.props;

const brandSuffix = page.path === '/' ? '' : ` · ${home.title}`;
const pageTitle = [site.brand, page.title].filter(Boolean).join(' · ') + brandSuffix;
const description = page.description ?? page.tagline ?? '';

const navItems = (page.blocks || [])
  .map((block, i) => ({ index: i, label: block.nav }))
  .filter((item) => item.label);

// 首页滚动分屏：介绍 / 这里亮着 / 最近做的 + 和我聊聊
const screenMap = page.scroll ? [0, 1, 2, 3] : undefined;
---

<Layout title={pageTitle} description={description}>
  <div class={page.wide ? 'shell shell-wide' : 'shell'}>
    <header class="intro">
      <p class="brand">{site.brand} <span class="brand-en">{site.brandEn}</span></p>

      <h1 class="name">{page.title}</h1>

      <p class="tagline">{page.tagline}</p>

      <footer class="intro-foot">
        {page.back ? (
          <a href="/">← 回首页</a>
        ) : (
          <a href={`mailto:${site.email}`}>{site.email}</a>
        )}
      </footer>
    </header>

    {!page.scroll && (
      <nav class="chapters" aria-label="页面导航">
        {navItems.map((item) => (
          <a class="chapter-link" href={`#block-${item.index}`}>{item.label}</a>
        ))}
      </nav>
    )}

    <main class={page.scroll ? 'content content-scroll' : 'content'}>
      <Blocks blocks={page.blocks} screenMap={screenMap} />
    </main>
  </div>
</Layout>

<script>
  const root = document.querySelector('.content-scroll');
  if (root) {
    const sections = [...root.querySelectorAll('.section')];
    const screens = [...new Set(sections.map((s) => Number(s.dataset.screen)))].sort((a, b) => a - b);
    let current = 0;
    let locked = false;

    const apply = () => {
      sections.forEach((s) => {
        s.classList.toggle('is-active', Number(s.dataset.screen) === screens[current]);
      });
    };

    const go = (next) => {
      if (next < 0 || next >= screens.length || next === current) return;
      current = next;
      locked = true;
      apply();
      window.setTimeout(() => {
        locked = false;
      }, 650);
    };

    apply();

    window.addEventListener(
      'wheel',
      (event) => {
        if (locked) return;
        if (Math.abs(event.deltaY) < 8) return;
        go(current + (event.deltaY > 0 ? 1 : -1));
        event.preventDefault();
      },
      { passive: false }
    );

    window.addEventListener('keydown', (event) => {
      if (event.key === 'PageDown' || event.key === 'ArrowDown') {
        event.preventDefault();
        go(current + 1);
      } else if (event.key === 'PageUp' || event.key === 'ArrowUp') {
        event.preventDefault();
        go(current - 1);
      }
    });
  }
</script>
