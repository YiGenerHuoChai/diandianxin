---
import Layout from '../layouts/Layout.astro';
import site from '../content/site.json';

const toDatetime = (date: string) => date.replaceAll('.', '-');
---

<Layout
  title={[site.brand, site.name].filter(Boolean).join(' · ') || '点心'}
  description={`${[site.brand, site.tagline].filter(Boolean).join('：')}。心理学小知识、经典实验和小测评。`}
>
  <div class="shell">
    <header class="intro">
      <p class="brand">{site.brand} <span class="brand-en">{site.brandEn}</span></p>

      <h1 class="name">{site.name || site.brand}</h1>

      <p class="tagline">{site.tagline}</p>

      <footer class="intro-foot">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </footer>
    </header>

    <nav class="chapters" aria-label="章节目录">
      <a class="chapter-link" href="#grow">{site.chapters.grow}</a>
      <a class="chapter-link" href="#now">{site.chapters.now}</a>
      <a class="chapter-link" href="#contact">{site.chapters.contact}</a>
    </nav>

    <main class="content">
      <section class="opening" aria-label="开场">
        {site.opening.map((paragraph, index) =>
          index === 0 ? (
            <p class="lead">{paragraph}</p>
          ) : (
            <p class="copy">{paragraph}</p>
          )
        )}
      </section>

      <section id="grow" class="section" aria-label={site.chapters.grow}>
        <ol class="items">
          {site.grow.map((item) => (
            <li class="item">
              <span class="item-no">{item.no}</span>
              <div>
                {item.href ? (
                  <a class="item-link" href={item.href}>
                    <h3 class="item-title">{item.title}</h3>
                  </a>
                ) : (
                  <h3 class="item-title">{item.title}</h3>
                )}
                <p class="item-desc">{item.desc}</p>
                <span class="status">{item.status}</span>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="now" class="section" aria-label={site.chapters.now}>
        <ul class="timeline">
          {site.now.map((entry) => (
            <li>
              <time datetime={toDatetime(entry.date)}>{entry.date}</time>
              <span>{entry.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="contact" class="section" aria-label={site.chapters.contact}>
        <p class="copy">{site.contact.text}</p>
        <p class="copy">
          <a class="contact-link" href={`mailto:${site.contact.email}`}>
            {site.contact.email}
          </a>
        </p>
      </section>
    </main>
  </div>
</Layout>
