---
import Layout from '../layouts/Layout.astro';
import site from '../content/site.json';

/* 实验目录：第一批要做的经典范式。做好一个，就把这一项换成可点的链接。 */
const experiments = [
  {
    no: '01',
    zh: 'Stroop 色词',
    en: 'Stroop Task',
    desc: '用墨水的颜色读字，别念出字本身——字的含义会拖你的后腿。',
    cat: '抑制控制',
    time: '1 分钟',
  },
  {
    no: '02',
    zh: 'Flanker 侧抑制',
    en: 'Flanker Task',
    desc: '中间那个箭头指向哪边？旁边的箭头会干扰你。',
    cat: '注意',
    time: '1 分钟',
  },
  {
    no: '03',
    zh: 'N-Back',
    en: 'N-Back Task',
    desc: '这个词和 n 步之前那个一样吗？工作记忆的照妖镜。',
    cat: '工作记忆',
    time: '2 分钟',
  },
  {
    no: '04',
    zh: 'Go / No-Go',
    en: 'Go/No-Go Task',
    desc: '该按的时候按，不该按的时候忍住——考验冲动控制。',
    cat: '反应控制',
    time: '1 分钟',
  },
  {
    no: '05',
    zh: '视觉搜索',
    en: 'Visual Search',
    desc: '在一堆干扰项里找出目标，越快越好。',
    cat: '注意',
    time: '1 分钟',
  },
  {
    no: '06',
    zh: '心理旋转',
    en: 'Mental Rotation',
    desc: '旋转过的图形，是同一个还是镜像？',
    cat: '空间认知',
    time: '1 分钟',
  },
  {
    no: '07',
    zh: '缪勒-莱尔错觉',
    en: 'Müller-Lyer Illusion',
    desc: '两条一样长的线，为什么看起来一长一短？',
    cat: '视知觉',
    time: '30 秒',
  },
  {
    no: '08',
    zh: '序列学习',
    en: 'Sequence Learning',
    desc: '你还没意识到，手已经记住了规律。',
    cat: '内隐学习',
    time: '2 分钟',
  },
];
---

<Layout
  title={`可交互实验 · ${site.brand || site.name}`}
  description="点心 · 可交互实验：把心理学经典实验做成能玩一轮的小程序。"
>
  <div class="shell">
    <header class="intro">
      <p class="brand">{site.brand} <span class="brand-en">{site.brandEn}</span></p>

      <h1 class="name">可交互实验</h1>

      <p class="tagline">做一遍，比读十遍记得牢。</p>

      <footer class="intro-foot">
        <a href="/">← 回首页</a>
      </footer>
    </header>

    <nav class="chapters" aria-label="页面导航">
      <a class="chapter-link" href="#lab">实验目录</a>
    </nav>

    <main class="content">
      <section id="lab" class="section" aria-label="实验目录">
        <p class="copy">
          心理学里那些经典实验，读起来是一回事，亲手玩一遍是另一回事。这里会放它们的小程序版本：点开就能玩一轮，玩完能看到自己的结果。
        </p>
        <p class="copy">
          下面是第一批要做的，现在还在筹备中——做好一个，放出来一个。
        </p>

        <ol class="items">
          {experiments.map((exp) => (
            <li class="item">
              <span class="item-no">{exp.no}</span>
              <div>
                <h3 class="item-title">
                  {exp.zh} <span class="item-en">{exp.en}</span>
                </h3>
                <p class="item-desc">{exp.desc}</p>
                <p class="item-meta">{exp.cat} · {exp.time}</p>
                <span class="status">筹备中</span>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </main>
  </div>
</Layout>
